# planner.captechvn.com — copy to .env.planner (never commit it) and fill in the secrets.
# Used by: docker compose -f docker-compose.planner.yml --env-file .env.planner up -d --build

# Postgres (the compose file builds DATABASE_URL from these for the app container).
# Use hex: base64 characters (+ / =) would break the DATABASE_URL.
#   openssl rand -hex 24
POSTGRES_USER=planner
POSTGRES_DB=planner
POSTGRES_PASSWORD=change-me

# JWT signing secret, at least 32 characters:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-the-output-of-openssl-rand-hex-32

# Public origin (email links, must be https in production) and the allowed CORS origin.
PUBLIC_URL=https://planner.captechvn.com
CORS_ORIGINS=https://planner.captechvn.com

# Self-registration is closed; create users with:
#   docker compose -f docker-compose.planner.yml --env-file .env.planner exec app \
#     node dist/scripts/set-password.js user@example.com
REGISTRATION_DISABLED=true
# Optional extra guard (comma-separated emails or *@domain); empty = no allowlist.
ALLOWED_EMAILS=

# Host loopback port that nginx-proxy-manager forwards to (container port is 1900).
APP_PORT=1900

# WEB_ROOT=/app/web is baked into the image. trustProxy is fixed to 1 hop in code
# (NPM is the single proxy); there is no TRUST_PROXY variable.
